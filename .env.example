# Record Audio Module Defaults
RECORD_AUDIO_DEFAULT_FORMAT=flac
RECORD_AUDIO_DEFAULT_SAMPLERATE=44100
RECORD_AUDIO_DEFAULT_CHANNELS=1
RECORD_AUDIO_DATE_FORMAT=%Y-%m-%d-%H-%M

# Audio Converter Module Defaults
AUDIO_CONVERTER_ASK_ON_OVERWRITE=false

# Speech-To-Text Module Defaults
# Transcription provider: parakeet.
STT_PROVIDER=parakeet
# Parakeet HF model id.
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
# Torch device override. Unset = auto-detect (mps if available, else cpu).
# STT_DEVICE=cpu
# Target format for FFmpeg pre-conversion when the input format is not
# natively supported by the provider. One of: wav, mp3, flac, ogg, m4a, mp4.
STT_PRECONVERSION_FORMAT=flac

# speech-to-text-modern only: auto-copy the transcription to the system
# clipboard (uses pbcopy/wl-copy/xclip/xsel). Equivalent CLI flag: --copy.
# STT_COPY=1
# speech-to-text-modern only: show a desktop notification when the
# transcription is ready (uses osascript/notify-send). Equivalent CLI flag: --notify.
# STT_NOTIFY=1
